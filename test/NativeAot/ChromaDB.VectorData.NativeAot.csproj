<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published with NativeAOT in CI and run against Chroma: a trimming or NativeAOT warning fails the publish. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ChromaDB.VectorData\ChromaDB.VectorData.csproj" />
  </ItemGroup>

</Project>
